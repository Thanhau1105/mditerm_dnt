{
  "name": "vku-student-management-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "REST API for VKU Student Management, using real MongoDB",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
